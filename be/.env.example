NODE_ENV=production
PORT=4000

# Các domain frontend được phép gọi API, phân tách bằng dấu phẩy.
APP_ORIGIN=https://mocmoc.vn,https://www.mocmoc.vn,https://admin.mocmoc.vn,http://localhost:3000

# Khóa quản trị cho trang /admin và API /api/admin.
ADMIN_API_KEY=your_strong_admin_key
UPLOAD_DIR=/app/uploads

# MySQL server
DB_HOST=36.50.27.243
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=default
DB_CONNECTION_LIMIT=10

# Đặt 1 khi API chạy sau proxy như Coolify/Nginx/Cloudflare.
TRUST_PROXY=1
